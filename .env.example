# Student Configuration
STUDENT_SECRET=your_secret_here
EMAIL=your_email@example.com

# LLM API Keys (in priority order - Groq is recommended)
# Option 1: Groq (FASTEST, highest rate limits - RECOMMENDED)
GROQ_API_KEY=gsk_your_groq_key_here

# Option 2: OpenAI (Good fallback)
OPENAI_API_KEY=sk-your_openai_key_here

# Option 3: Gemini (Original, but has low rate limits)
GEMINI_API_KEY=your_gemini_key_here

# Note: You only need ONE of these, but having multiple provides fallbacks
